{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/tools/guard-gh.ps1",
            "timeout": 15,
            "statusMessage": "Checking who that would file as"
          }
        ]
      }
    ]
  }
}
